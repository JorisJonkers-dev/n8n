# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
N8N_PROTOCOL=${exposure:n8n.public#scheme}
N8N_HOST=${exposure:n8n.public#host}
N8N_EDITOR_BASE_URL=${exposure:n8n.public#url}
WEBHOOK_URL=${exposure:n8n.public#url}/
# Traefik is the one proxy that sets X-Forwarded-For.
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=${secret:secret/data/platform/automation#n8n.encryption_key}
N8N_REINSTALL_MISSING_PACKAGES=true
# n8n keeps its user folder at $HOME/.n8n, the n8n-data claim. deploy-kit 1.3.1
# points HOME at /tmp on a container with a writable /tmp unless the Process
# names HOME itself (deploy-kit spec/v1/10-project-intent.md#home-is-the-writable-tmp),
# so HOME is named here, as the image's own user has it.
HOME=/home/node

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${dependency:platform-postgres.host}
DB_POSTGRESDB_PORT=${dependency:platform-postgres.port}
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=${dependency:platform-postgres.username}
DB_POSTGRESDB_PASSWORD=${dependency:platform-postgres.password}

OIDC_ISSUER_URL=${exposure:auth.public#url}
OIDC_CLIENT_ID=n8n
OIDC_CLIENT_SECRET=${secret:secret/data/platform/automation#n8n.oauth_client_secret}
OIDC_REDIRECT_URI=${exposure:n8n.public#url}/auth/oidc/callback
OIDC_SCOPES=openid email profile

N8N_METRICS=true
N8N_METRICS_INCLUDE_DEFAULT_METRICS=true
N8N_METRICS_INCLUDE_API_ENDPOINTS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=true
